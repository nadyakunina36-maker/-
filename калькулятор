<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Калькулятор стоимости бухгалтерского сопровождения — НВ.БУХ</title>
  <style>
    :root {
      --green: #123F36;
      --green-2: #0E322C;
      --milk: #F7F4EE;
      --gold: #D6BE8D;
      --text: #173D35;
      --muted: #6E756F;
      --white: #FFFFFF;
      --line: rgba(18, 63, 54, 0.12);
      --shadow: 0 18px 50px rgba(18, 63, 54, 0.12);
      --radius: 28px;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: var(--milk);
      color: var(--text);
    }

    .page {
      max-width: 1180px;
      margin: 0 auto;
      padding: 28px 18px 60px;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 34px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo {
      width: 54px;
      height: 54px;
      border-radius: 17px;
      background: var(--green);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: Georgia, serif;
      font-weight: 700;
      font-size: 26px;
    }

    .brand-title {
      font-family: Georgia, serif;
      font-size: 28px;
      line-height: 1;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--green);
    }

    .brand-subtitle {
      margin-top: 6px;
      font-size: 12px;
      letter-spacing: 0.18em;
      color: var(--muted);
      text-transform: uppercase;
    }

    .header-buttons {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .pill {
      border: 0;
      border-radius: 999px;
      padding: 15px 28px;
      font-size: 16px;
      font-weight: 700;
      cursor: pointer;
    }

    .pill.gold {
      background: var(--gold);
      color: var(--green);
    }

    .pill.green {
      background: var(--green);
      color: var(--white);
    }

    .hero {
      display: grid;
      grid-template-columns: 1.08fr 0.92fr;
      background: var(--green);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow);
      margin-bottom: 28px;
      min-height: 390px;
    }

    .hero-content {
      padding: 70px 66px;
      color: var(--white);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      width: fit-content;
      border: 1px solid rgba(255,255,255,0.18);
      background: rgba(255,255,255,0.10);
      color: var(--gold);
      border-radius: 999px;
      padding: 10px 20px;
      font-size: 12px;
      letter-spacing: 0.16em;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 34px;
    }

    h1 {
      font-family: Georgia, serif;
      font-size: clamp(38px, 5vw, 72px);
      line-height: 0.98;
      margin: 0 0 26px;
      letter-spacing: -0.04em;
      font-weight: 700;
    }

    .hero-text {
      color: rgba(255,255,255,0.74);
      font-size: 19px;
      line-height: 1.45;
      max-width: 620px;
      margin: 0;
    }

    .hero-side {
      background:
        linear-gradient(135deg, rgba(214,190,141,0.18), rgba(255,255,255,0.04)),
        var(--green-2);
      padding: 42px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .price-card {
      background: var(--milk);
      color: var(--green);
      border-radius: 26px;
      padding: 36px;
      width: 100%;
      max-width: 380px;
    }

    .price-label {
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.16em;
      color: var(--muted);
      margin-bottom: 14px;
      font-weight: 700;
    }

    .price {
      font-family: Georgia, serif;
      font-size: 42px;
      line-height: 1;
      font-weight: 700;
      margin-bottom: 14px;
    }

    .price-note {
      color: var(--muted);
      line-height: 1.5;
      font-size: 14px;
    }

    .grid {
      display: grid;
      grid-template-columns: 1fr 360px;
      gap: 24px;
      align-items: start;
    }

    .card {
      background: var(--white);
      border-radius: 24px;
      padding: 28px;
      box-shadow: 0 10px 30px rgba(18, 63, 54, 0.07);
      border: 1px solid var(--line);
      margin-bottom: 18px;
    }

    .card h2 {
      margin: 0 0 20px;
      font-family: Georgia, serif;
      color: var(--green);
      font-size: 30px;
      line-height: 1.1;
    }

    .section-title {
      font-weight: 800;
      color: var(--green);
      margin: 24px 0 12px;
      font-size: 17px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--muted);
      margin-bottom: 8px;
      font-weight: 700;
    }

    input,
    select {
      width: 100%;
      border: 1px solid var(--line);
      background: #FBFAF7;
      border-radius: 14px;
      padding: 13px 14px;
      font-size: 15px;
      color: var(--text);
      outline: none;
    }

    input:focus,
    select:focus {
      border-color: var(--gold);
      box-shadow: 0 0 0 3px rgba(214,190,141,0.23);
    }

    .check-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .check {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: #FBFAF7;
      border: 1px solid var(--line);
      border-radius: 14px;
      padding: 12px;
      cursor: pointer;
      min-height: 58px;
    }

    .check input {
      width: 18px;
      height: 18px;
      margin-top: 1px;
      accent-color: var(--green);
      flex: 0 0 auto;
    }

    .check span {
      font-size: 14px;
      line-height: 1.25;
      color: var(--text);
    }

    .summary {
      position: sticky;
      top: 18px;
    }

    .summary .card {
      background: var(--green);
      color: var(--white);
      border: 0;
    }

    .summary h2 {
      color: var(--white);
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      border-bottom: 1px solid rgba(255,255,255,0.12);
      padding: 11px 0;
      font-size: 14px;
    }

    .summary-row span:first-child {
      color: rgba(255,255,255,0.70);
    }

    .summary-row span:last-child {
      font-weight: 700;
      text-align: right;
    }

    .summary-total {
      background: var(--gold);
      color: var(--green);
      border-radius: 20px;
      padding: 22px;
      margin-top: 18px;
      text-align: center;
    }

    .summary-total div:first-child {
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .summary-total div:last-child {
      font-family: Georgia, serif;
      font-size: 34px;
      font-weight: 800;
      line-height: 1;
    }

    .actions {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      flex-wrap: wrap;
    }

    .btn {
      border: 0;
      border-radius: 14px;
      padding: 14px 18px;
      font-weight: 800;
      cursor: pointer;
      font-size: 14px;
    }

    .btn.gold {
      background: var(--gold);
      color: var(--green);
    }

    .btn.light {
      background: rgba(255,255,255,0.12);
      color: var(--white);
    }

    .note {
      margin-top: 14px;
      color: rgba(255,255,255,0.65);
      font-size: 12px;
      line-height: 1.45;
    }

    .commercial {
      display: none;
      margin-top: 22px;
      background: var(--milk);
      border-radius: 24px;
      overflow: hidden;
      border: 1px solid var(--line);
    }

    .commercial.show {
      display: block;
    }

    .kp-head {
      background: var(--green);
      color: var(--white);
      padding: 38px;
    }

    .kp-head h2 {
      font-family: Georgia, serif;
      font-size: 42px;
      line-height: 1;
      margin: 0 0 18px;
      color: var(--white);
    }

    .kp-body {
      padding: 30px 38px 38px;
      background: var(--milk);
    }

    .kp-list {
      columns: 2;
      margin: 12px 0 0;
      padding: 0;
      list-style: none;
    }

    .kp-list li {
      break-inside: avoid;
      margin: 0 0 12px;
      color: var(--green);
    }

    .kp-list li::before {
      content: "✓ ";
      font-weight: 900;
      color: var(--green);
    }

    .kp-final {
      background: var(--gold);
      color: var(--green);
      padding: 24px;
      border-radius: 20px;
      margin-top: 24px;
      font-family: Georgia, serif;
      font-size: 30px;
      font-weight: 800;
      text-align: center;
    }

    .error {
      background: #FFF3F0;
      color: #8A2D1D;
      border: 1px solid #F2C5BA;
      padding: 12px 14px;
      border-radius: 14px;
      display: none;
      margin-bottom: 14px;
      font-size: 14px;
    }

    .error.show {
      display: block;
    }

    @media (max-width: 920px) {
      .hero,
      .grid {
        grid-template-columns: 1fr;
      }

      .hero-content {
        padding: 46px 30px;
      }

      .hero-side {
        padding: 28px;
      }

      .summary {
        position: static;
      }
    }

    @media (max-width: 620px) {
      .form-grid,
      .check-grid {
        grid-template-columns: 1fr;
      }

      .header {
        align-items: flex-start;
        flex-direction: column;
      }

      .kp-list {
        columns: 1;
      }
    }

    @media print {
      body {
        background: white;
      }

      .header,
      .hero,
      .grid,
      .actions,
      .note,
      .error {
        display: none !important;
      }

      .commercial {
        display: block !important;
        border: 0;
        margin: 0;
      }

      .page {
        max-width: none;
        padding: 0;
      }
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="header">
      <div class="brand">
        <div class="logo">НВ</div>
        <div>
          <div class="brand-title">НВ.БУХ</div>
          <div class="brand-subtitle">Бухгалтерский аутсорсинг</div>
        </div>
      </div>
      <div class="header-buttons">
        <button class="pill gold" onclick="document.getElementById('calculator').scrollIntoView({behavior:'smooth'})">Рассчитать стоимость</button>
        <button class="pill green">Консультация</button>
      </div>
    </header>

    <section class="hero">
      <div class="hero-content">
        <div class="badge">★★★★★ Бухгалтерский аутсорсинг</div>
        <h1>Бухгалтерия без штрафов, хаоса и просрочек</h1>
        <p class="hero-text">Рассчитайте предварительную стоимость бухгалтерского сопровождения по объему учета, налоговой системе и особенностям бизнеса.</p>
      </div>
      <div class="hero-side">
        <div class="price-card">
          <div class="price-label">Предварительная стоимость</div>
          <div class="price" id="heroPrice">0 ₽</div>
          <div class="price-note">Расчет не является публичной офертой. Финальная стоимость может быть уточнена после анализа базы учета.</div>
        </div>
      </div>
    </section>

    <div class="grid" id="calculator">
      <main>
        <div class="card">
          <h2>Калькулятор стоимости</h2>
          <div class="error" id="errorBox"></div>

          <div class="section-title">Контакты</div>
          <div class="form-grid">
            <div>
              <label for="company">Название компании</label>
              <input id="company" type="text" placeholder="ООО Ромашка" />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" type="email" placeholder="mail@example.ru" />
            </div>
            <div>
              <label for="phone">Телефон</label>
              <input id="phone" type="text" placeholder="+7..." />
            </div>
          </div>

          <div class="section-title">Основные параметры</div>
          <div class="form-grid">
            <div>
              <label for="opf">Форма бизнеса</label>
              <select id="opf">
                <option>ИП без работников</option>
                <option>ИП с работниками</option>
                <option selected>ООО</option>
              </select>
            </div>

            <div>
              <label for="sno">Система налогообложения</label>
              <select id="sno">
                <option selected>УСН Доходы</option>
                <option>УСН Доходы-Расходы</option>
                <option>ПСН+нулевка</option>
                <option>ОСН</option>
                <option>УСН Доходы+ПСН</option>
                <option>УСН Доходы-Расходы+ПСН</option>
                <option>ОСН+ПСН</option>
              </select>
            </div>

            <div>
              <label for="vat">НДС</label>
              <select id="vat">
                <option>без НДС</option>
                <option>С НДС 5/7</option>
                <option selected>С НДС 0/10/20</option>
              </select>
            </div>
          </div>

          <div class="section-title">Дополнительные часы</div>
          <div class="form-grid">
            <div><label>Доп. расчетные счета</label><input id="extraBankAccounts" type="number" min="0" value="0" /></div>
            <div><label>ККТ</label><input id="kktCount" type="number" min="0" value="0" /></div>
            <div><label>Доп. патенты</label><input id="extraPatents" type="number" min="0" value="0" /></div>
            <div><label>Договоры с маркетплейсами</label><input id="marketplaceContracts" type="number" min="0" value="0" /></div>
            <div><label>Работники-граждане РФ</label><input id="russianEmployees" type="number" min="0" value="0" /></div>
            <div><label>Иностранцы без патента</label><input id="foreignNoPatent" type="number" min="0" value="0" /></div>
            <div><label>Иностранцы с патентом</label><input id="foreignWithPatent" type="number" min="0" value="0" /></div>
            <div><label>ВКС</label><input id="hqs" type="number" min="0" value="0" /></div>
            <div><label>Подрядчики ФЛ ГПХ</label><input id="gph" type="number" min="0" value="0" /></div>
          </div>

          <div class="check-grid" style="margin-top: 14px;">
            <label class="check"><input id="tradeAcquiring" type="checkbox" /><span>Торговый эквайринг</span></label>
            <label class="check"><input id="internetAcquiring" type="checkbox" /><span>Интернет-эквайринг</span></label>
          </div>

          <div class="section-title">Операции</div>
          <div class="form-grid">
            <div><label>Платежные поручения</label><input id="paymentOrders" type="number" min="0" value="0" /></div>
            <div><label>Поступления</label><input id="receipts" type="number" min="0" value="0" /></div>
            <div><label>Реализация</label><input id="sales" type="number" min="0" value="0" /></div>
            <div><label>Авансовые отчеты</label><input id="advanceReports" type="number" min="0" value="0" /></div>
          </div>

          <div class="section-title">Коэффициенты</div>
          <div class="check-grid">
            <label class="check"><input id="severalDirections" type="checkbox" /><span>Несколько видов деятельности</span></label>
            <label class="check"><input id="complexBusiness" type="checkbox" /><span>Строительство, производство, общепит</span></label>
            <label class="check"><input id="agentWork" type="checkbox" /><span>Посредническая деятельность</span></label>
            <label class="check"><input id="marketplaces" type="checkbox" /><span>Торговля на маркетплейсах</span></label>
            <label class="check"><input id="separateVat" type="checkbox" /><span>Раздельный учет НДС</span></label>
            <label class="check"><input id="exportVat" type="checkbox" /><span>Экспорт / возмещение НДС</span></label>
            <label class="check"><input id="foreignPartners" type="checkbox" /><span>ВЭД, валютные операции</span></label>
            <label class="check"><input id="securities" type="checkbox" /><span>Ценные бумаги</span></label>
            <label class="check"><input id="factoring" type="checkbox" /><span>Факторинг</span></label>
            <label class="check"><input id="branches" type="checkbox" /><span>Обособленные подразделения</span></label>
            <label class="check"><input id="bigNomenclature" type="checkbox" /><span>Номенклатура свыше 10 позиций</span></label>
            <label class="check"><input id="frequentAdvances" type="checkbox" /><span>Авансовые расчеты чаще 1 раза в месяц</span></label>
            <label class="check"><input id="loans" type="checkbox" /><span>Займы, кредиты, гарантии</span></label>
            <label class="check"><input id="creditReports" type="checkbox" /><span>Отчеты по кредитам/гарантиям</span></label>
          </div>

          <div class="section-title">Первичные документы</div>
          <div class="form-grid">
            <div>
              <label for="primaryNeed">Оформлять первичные документы?</label>
              <select id="primaryNeed">
                <option>Нет</option>
                <option>Да</option>
              </select>
            </div>
            <div>
              <label for="primaryCount">Количество первичных документов</label>
              <input id="primaryCount" type="number" min="0" value="0" />
            </div>
          </div>
        </div>

        <section class="commercial" id="kpBlock">
          <div class="kp-head">
            <div class="badge">НВ.БУХ</div>
            <h2>Коммерческое предложение</h2>
            <p id="kpCompanyText">Для компании</p>
          </div>
          <div class="kp-body">
            <p>Мы подготовили расчет стоимости бухгалтерского сопровождения с учетом формы бизнеса, системы налогообложения и особенностей учета.</p>

            <h3>Параметры расчета</h3>
            <p id="kpParams"></p>

            <h3>Что входит в сопровождение</h3>
            <ul class="kp-list">
              <li>Ведение бухгалтерского и налогового учета</li>
              <li>Подготовка и сдача отчетности</li>
              <li>Контроль сроков и налогов</li>
              <li>Консультационная поддержка</li>
              <li>Работа с первичными документами</li>
              <li>Расчет обязательных платежей</li>
              <li>Проверка корректности учета</li>
              <li>Поддержка по вопросам учета</li>
            </ul>

            <div class="kp-final" id="kpTotal">Стоимость обслуживания: 0 ₽ / месяц</div>
            <p style="color:#6E756F; font-size:13px; line-height:1.5; margin-top:18px;">Стоимость рассчитана на основании предоставленных данных. Финальная цена может быть уточнена после анализа базы учета, первичных документов и фактического объема работ.</p>
          </div>
        </section>
      </main>

      <aside class="summary">
        <div class="card">
          <h2>Расчет</h2>
          <div class="summary-row"><span>Базовые часы</span><span id="baseHoursOut">0</span></div>
          <div class="summary-row"><span>Доп. часы</span><span id="additionalHoursOut">0</span></div>
          <div class="summary-row"><span>Часы по операциям</span><span id="operationHoursOut">0</span></div>
          <div class="summary-row"><span>Коэффициент</span><span id="coefficientOut">1</span></div>
          <div class="summary-row"><span>До коэффициента</span><span id="beforeOut">0 ₽</span></div>
          <div class="summary-row"><span>После коэффициента</span><span id="afterOut">0 ₽</span></div>
          <div class="summary-row"><span>Первичные документы</span><span id="primaryOut">0 ₽</span></div>

          <div class="summary-total">
            <div>Итоговая стоимость</div>
            <div id="totalOut">0 ₽</div>
          </div>

          <div class="actions">
            <button class="btn gold" onclick="showKP()">Сформировать КП</button>
            <button class="btn light" onclick="window.print()">Сохранить PDF</button>
          </div>
          <div class="note">Логика расчета: коэффициент увеличивает только базовую стоимость. Итог = базовые часы × 2500 × коэффициент + доп. часы × 2500 + часы по операциям × 2500 + первичные документы.</div>
        </div>
      </aside>
    </div>
  </div>

  <script>
    const HOUR_RATE = 2500;
    const PRIMARY_DOC_PRICE = 120;
    const MAX_COEFFICIENT = 1.6;

    const tariffs = [
      { opf: "ИП без работников", sno: "УСН Доходы", "без НДС": 3, "С НДС 5/7": 3.6, "С НДС 0/10/20": 4.8 },
      { opf: "ИП без работников", sno: "УСН Доходы-Расходы", "без НДС": 4.2, "С НДС 5/7": 5.04, "С НДС 0/10/20": 6.72 },
      { opf: "ИП без работников", sno: "ПСН+нулевка", "без НДС": 3.6, "С НДС 5/7": 3.6, "С НДС 0/10/20": 3.6 },
      { opf: "ИП с работниками", sno: "УСН Доходы", "без НДС": 6, "С НДС 5/7": 7.2, "С НДС 0/10/20": 9.6 },
      { opf: "ООО", sno: "УСН Доходы", "без НДС": 9, "С НДС 5/7": 10.8, "С НДС 0/10/20": 14.4 },
      { opf: "ООО", sno: "УСН Доходы-Расходы", "без НДС": 12.6, "С НДС 5/7": 15.12, "С НДС 0/10/20": 20.16 },
      { opf: "ООО", sno: "ОСН", "без НДС": 0, "С НДС 5/7": 16.2, "С НДС 0/10/20": 16.2 }
    ];

    const extraHours = {
      "extraBankAccounts": 1,
      "kktCount": 1,
      "tradeAcquiring": 1,
      "internetAcquiring": 0.5,
      "extraPatents": 1.5,
      "marketplaceContracts": 1,
      "russianEmployees": 0.25,
      "foreignNoPatent": 0.375,
      "foreignWithPatent": 0.5,
      "hqs": 1,
      "gph": 0.5,
      "paymentOrders": 0.1,
      "receipts": 0.15,
      "sales": 0.15,
      "advanceReports": 0.25
    };

    const coefficients = {
      "severalDirections": 1.25,
      "complexBusiness": 1.35,
      "agentWork": 1.3,
      "marketplaces": 1.3,
      "separateVat": 1.15,
      "exportVat": 1.5,
      "foreignPartners": 1.25,
      "securities": 1.3,
      "factoring": 1.35,
      "branches": 1.3,
      "bigNomenclature": 1.1,
      "frequentAdvances": 1.1,
      "loans": 1.1,
      "creditReports": 1.1
    };

    function num(id) {
      return Number(document.getElementById(id).value || 0);
    }

    function checked(id) {
      return document.getElementById(id).checked;
    }

    function money(value) {
      return new Intl.NumberFormat("ru-RU", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(value) + " ₽";
    }

    function numberRu(value) {
      return new Intl.NumberFormat("ru-RU", {
        minimumFractionDigits: 0,
        maximumFractionDigits: 3
      }).format(value);
    }

    function findBaseHours(opf, sno, vat) {
      const row = tariffs.find(item => item.opf === opf && item.sno === sno);
      if (!row) return null;
      return row[vat] ?? null;
    }

    function calculate() {
      const errorBox = document.getElementById("errorBox");
      errorBox.classList.remove("show");
      errorBox.textContent = "";

      const opf = document.getElementById("opf").value;
      const sno = document.getElementById("sno").value;
      const vat = document.getElementById("vat").value;

      const baseHours = findBaseHours(opf, sno, vat);

      if (baseHours === null) {
        errorBox.textContent = "Для выбранной комбинации ОПФ / СНО / НДС нет тарифа. Проверьте исходную таблицу тарифов.";
        errorBox.classList.add("show");
        return null;
      }

      let additionalHours = 0;
      additionalHours += num("extraBankAccounts") * extraHours.extraBankAccounts;
      additionalHours += num("kktCount") * extraHours.kktCount;
      additionalHours += checked("tradeAcquiring") ? extraHours.tradeAcquiring : 0;
      additionalHours += checked("internetAcquiring") ? extraHours.internetAcquiring : 0;
      additionalHours += num("extraPatents") * extraHours.extraPatents;
      additionalHours += num("marketplaceContracts") * extraHours.marketplaceContracts;
      additionalHours += num("russianEmployees") * extraHours.russianEmployees;
      additionalHours += num("foreignNoPatent") * extraHours.foreignNoPatent;
      additionalHours += num("foreignWithPatent") * extraHours.foreignWithPatent;

      // ВАЖНО: ВКС отключены из расчета по вашей последней правке.
      // additionalHours += num("hqs") * extraHours.hqs;

      additionalHours += num("gph") * extraHours.gph;

      let operationHours = 0;
      operationHours += num("paymentOrders") * extraHours.paymentOrders;
      operationHours += num("receipts") * extraHours.receipts;
      operationHours += num("sales") * extraHours.sales;
      operationHours += num("advanceReports") * extraHours.advanceReports;

      let coefficient = 1;
      Object.keys(coefficients).forEach(id => {
        if (checked(id)) {
          coefficient += coefficients[id] - 1;
        }
      });
      coefficient = Math.min(coefficient, MAX_COEFFICIENT);

      // Правильная логика:
      // Коэффициент увеличивает только базовую стоимость.
      // Остальные показатели просто прибавляются к базе.
      const costBeforeCoefficient =
        (baseHours + additionalHours + operationHours) * HOUR_RATE;

      const costAfterCoefficient =
        (baseHours * coefficient * HOUR_RATE) +
        (additionalHours * HOUR_RATE) +
        (operationHours * HOUR_RATE);

      const primaryDocsCost =
        document.getElementById("primaryNeed").value === "Да"
          ? num("primaryCount") * PRIMARY_DOC_PRICE
          : 0;

      const total = costAfterCoefficient + primaryDocsCost;

      const result = {
        baseHours,
        additionalHours,
        operationHours,
        coefficient,
        costBeforeCoefficient,
        costAfterCoefficient,
        primaryDocsCost,
        total,
        opf,
        sno,
        vat,
        company: document.getElementById("company").value || "клиента"
      };

      render(result);
      return result;
    }

    function render(result) {
      document.getElementById("baseHoursOut").textContent = numberRu(result.baseHours);
      document.getElementById("additionalHoursOut").textContent = numberRu(result.additionalHours);
      document.getElementById("operationHoursOut").textContent = numberRu(result.operationHours);
      document.getElementById("coefficientOut").textContent = numberRu(result.coefficient);
      document.getElementById("beforeOut").textContent = money(result.costBeforeCoefficient);
      document.getElementById("afterOut").textContent = money(result.costAfterCoefficient);
      document.getElementById("primaryOut").textContent = money(result.primaryDocsCost);
      document.getElementById("totalOut").textContent = money(result.total);
      document.getElementById("heroPrice").textContent = money(result.total).replace(",00", "");
    }

    function showKP() {
      const result = calculate();
      if (!result) return;

      document.getElementById("kpBlock").classList.add("show");
      document.getElementById("kpCompanyText").textContent = "Для компании: " + result.company;
      document.getElementById("kpParams").innerHTML =
        "<strong>Форма бизнеса:</strong> " + result.opf + "<br>" +
        "<strong>Система налогообложения:</strong> " + result.sno + "<br>" +
        "<strong>НДС:</strong> " + result.vat + "<br>" +
        "<strong>Базовые часы:</strong> " + numberRu(result.baseHours) + "<br>" +
        "<strong>Дополнительные часы:</strong> " + numberRu(result.additionalHours) + "<br>" +
        "<strong>Итоговый коэффициент:</strong> " + numberRu(result.coefficient);

      document.getElementById("kpTotal").textContent =
        "Стоимость обслуживания: " + money(result.total) + " / месяц";

      document.getElementById("kpBlock").scrollIntoView({ behavior: "smooth" });
    }

    document.querySelectorAll("input, select").forEach(el => {
      el.addEventListener("input", calculate);
      el.addEventListener("change", calculate);
    });

    calculate();
  </script>
</body>
</html>
